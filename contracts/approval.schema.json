{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval.schema.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "state", "expires_at", "amount", "merchant", "excerpt", "rule", "decision_id", "order"],
  "properties": {
    "approval_id": { "type": "string" },
    "state": { "enum": ["pending", "approved", "rejected", "expired", "cancelled"] },
    "message": { "type": "string", "maxLength": 140 },
    "expires_at": { "type": "string" },
    "amount": { "type": "number" },
    "merchant": { "type": "string" },
    "excerpt": { "type": "string" },
    "rule": { "type": "string" },
    "decision_id": { "type": "string" },
    "order": { "type": ["object", "null"] }
  }
}
