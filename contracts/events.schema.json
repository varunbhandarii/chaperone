{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Ledger event",
  "description": "POST {relay}/events. Senders set type, session_id, mandate_id, t and source; the relay adds rt and seq. An event without a session uses session_id \"none\". The wall renders the payloads in $defs.payloads and ignores other fields; their types are checked, and none of them is required yet.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "session_id",
    "mandate_id",
    "t",
    "source"
  ],
  "properties": {
    "type": {
      "enum": [
        "session_started",
        "heard",
        "items_found",
        "cart_updated",
        "checkout_requested",
        "policy_decision",
        "approval_requested",
        "approval_result",
        "refusal",
        "request_signed",
        "signature_verified",
        "signature_rejected",
        "payment_link_created",
        "order_created",
        "card_authorized",
        "card_auth_failed",
        "paid",
        "receipt_printed",
        "caregiver_alerted",
        "mandate_signed",
        "judge_scored",
        "replay_armed",
        "order_status",
        "order_cancelled",
        "refund_requested",
        "refund_result",
        "mandate_paused",
        "mandate_resumed",
        "explanation_requested",
        "reset",
        "scam_checked",
        "caution",
        "risk_changed",
        "card_decision",
        "card_hold_released",
        "bill_checked",
        "line_call",
        "vtc_decision",
        "risk_scored",
        "cosigned"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "not": {
        "const": "live"
      },
      "description": "\"live\" is reserved: the relay's all-sessions log is sessions/live.jsonl"
    },
    "mandate_id": {
      "type": "string",
      "minLength": 1
    },
    "t": {
      "type": "integer",
      "description": "sender clock, ms since epoch"
    },
    "source": {
      "enum": [
        "station",
        "policy",
        "merchant",
        "caregiver",
        "relay",
        "line"
      ]
    },
    "rt": {
      "type": "integer",
      "description": "relay receive time, ms since epoch (set by the relay)"
    },
    "seq": {
      "type": "integer",
      "description": "relay sequence number, monotonically increasing (set by the relay)"
    },
    "replay": {
      "type": "boolean",
      "description": "set by the station's cached-session replay; the wall labels these REPLAY"
    }
  },
  "$defs": {
    "payloads": {
      "heard": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "shopper",
              "agent",
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          },
          "item_id": {
            "type": "string",
            "description": "one line per turn: the wall replaces the line with the same item_id"
          }
        }
      },
      "items_found": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "price": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            }
          }
        }
      },
      "cart_updated": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "price": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            }
          },
          "total": {
            "type": [
              "number",
              "string"
            ]
          }
        }
      },
      "checkout_requested": {
        "type": "object",
        "properties": {
          "total": {
            "type": [
              "number",
              "string"
            ]
          }
        }
      },
      "refusal": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "spoken_key": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          }
        }
      },
      "policy_decision": {
        "type": "object",
        "properties": {
          "decision": {
            "enum": [
              "allow",
              "approve",
              "deny"
            ]
          },
          "decision_id": {
            "type": "string"
          },
          "rules_failed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "total": {
            "type": [
              "number",
              "string"
            ]
          }
        }
      },
      "request_signed": {
        "type": "object",
        "properties": {
          "keyid": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "expires": {
            "type": [
              "integer",
              "string"
            ],
            "description": "unix seconds, or ISO 8601"
          }
        }
      },
      "approval_requested": {
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string"
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "rule": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "description": "ISO 8601"
          }
        }
      },
      "approval_result": {
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "passkey",
              "code",
              "timeout",
              "cancelled"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 140
          },
          "error": {
            "type": "string"
          }
        }
      },
      "receipt_printed": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "via": {
            "enum": [
              "printer",
              "screen"
            ]
          }
        }
      },
      "paid": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "total": {
            "type": [
              "number",
              "string"
            ]
          },
          "via": {
            "type": "string"
          }
        }
      },
      "order_status": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "awaiting_payment",
              "paid",
              "preparing",
              "ready_for_pickup",
              "picked_up",
              "cancelled",
              "partially_refunded",
              "refunded"
            ]
          },
          "pickup_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "order_cancelled": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "link_status": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cybersource v-c-correlation-id of the PATCH (real links)"
          },
          "backend": {
            "enum": [
              "visa",
              "mock"
            ]
          }
        }
      },
      "refund_requested": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "refund_result": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "refund_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "TRANSMITTED",
              "FAILED",
              "REFUSED"
            ]
          },
          "amount": {
            "type": [
              "number",
              "string"
            ]
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          },
          "reconciliation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "card_last4": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "description": "The merchant posts one per refund state (PENDING, then TRANSMITTED). The label is always \"Refund to the original card · sandbox processor stub\"."
      },
      "mandate_paused": {
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "mandate_resumed": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          }
        }
      },
      "explanation_requested": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string"
          }
        }
      },
      "scam_checked": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "sources": {
            "type": "array"
          },
          "ms": {
            "type": "number"
          },
          "channel": {
            "type": "string"
          },
          "decision_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "dollars the story asked for; the protected-dollars counter adds it once per decision_id"
          }
        }
      },
      "caution": {
        "type": "object",
        "properties": {
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "enum": [
              "slow",
              "judge"
            ]
          },
          "words": {
            "type": [
              "string",
              "array"
            ]
          }
        }
      },
      "risk_changed": {
        "type": "object",
        "properties": {
          "cooldown_until": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "source_event": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "card_decision": {
        "type": "object",
        "properties": {
          "card_last4": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "mcc": {
            "type": "string"
          },
          "amount": {
            "type": [
              "string",
              "number"
            ]
          },
          "result": {
            "enum": [
              "approved",
              "declined"
            ]
          },
          "reason_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "hold_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cooldown": {
            "type": [
              "boolean",
              "object",
              "null"
            ]
          },
          "network": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Lithic's transaction token; vtc_decision names the same token"
          }
        }
      },
      "card_hold_released": {
        "type": "object",
        "properties": {
          "hold_id": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "max_amount": {
            "type": [
              "string",
              "number"
            ]
          },
          "allowed_until": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "bill_checked": {
        "type": "object",
        "properties": {
          "biller": {
            "type": "string"
          },
          "account_ref": {
            "type": "string"
          },
          "balance_due": {
            "type": [
              "string",
              "number"
            ]
          },
          "due_date": {
            "type": "string"
          },
          "past_due": {
            "type": "boolean"
          }
        }
      },
      "line_call": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "started",
              "ended"
            ]
          },
          "from_last4": {
            "type": "string"
          },
          "seconds": {
            "type": "number"
          }
        }
      },
      "vtc_decision": {
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "string",
              "null"
            ]
          },
          "store": {
            "type": "string"
          },
          "mcc": {
            "type": "string"
          },
          "amount": {
            "type": [
              "string",
              "number"
            ]
          },
          "should_decline": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "type": "number"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "risk_scored": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "ms": {
            "type": "number"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "cosigned": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "said": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          },
          "mandate_hash": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "heard"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/payloads/heard"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "items_found"
          }
        },
        "required": [
