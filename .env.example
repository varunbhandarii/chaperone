# Copy to .env (gitignored). Every service loads the repo-root .env.
# Put the real values in the shared vault, never in git or chat.
# The browser only ever receives an ephemeral voice token, never these keys.
# Keep comments on their own line: some loaders do not strip inline comments.

# --- shared ---
XAI_API_KEY=
# Address the station page and phones use for the services laptop (team router: 192.168.8.10)
SERVICES_HOST=localhost
# Relay ledger ingest; leave empty to keep events local
RELAY_URL=
POLICY_URL=http://127.0.0.1:8001
CATALOG_URL=http://127.0.0.1:8003

# --- caregiver passkeys ---
# Public HTTPS host the caregiver phone opens; the passkey RP ID is this host
TUNNEL_HOST=
# Defaults to https://TUNNEL_HOST when empty
ORIGIN=
ROOM_CODE=
# 0 lets a device without user verification register (testing only)
REQUIRE_UV=1

# --- merchant ---
# Cybersource sandbox: Organization ID = merchant id; Key Management -> REST Shared Secret gives key id + secret.
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_API_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=
# 1 = never call Visa (mock hosted page at MERCHANT_PUBLIC_URL/pay/<id>)
MOCK_VISA=0
# 1 = if the Visa call fails, create a mock link instead of failing the order
VISA_FALLBACK_TO_MOCK=1
# Base URL phones/tablets use to reach the merchant. Loopback for a laptop smoke test;
# on the team router set http://192.168.8.10:8002
MERCHANT_PUBLIC_URL=http://127.0.0.1:8002
# off = record the signature check as skipped; enforce = run the RFC 9421 verifier and reject failures
MERCHANT_VERIFY=off
# 1 = orders also get our checkout page (/checkout/<order_id>) that runs a real sandbox card
# authorization and marks paid only on AUTHORIZED (see docs/visa-sandbox-auth-error.md)
CARD_AUTH=0
# Optional: authorize on a different sandbox merchant the team owns (all three or none);
# empty = authorize on the VISA_ACCEPTANCE_* merchant above
CARD_AUTH_MERCHANT_ID=
CARD_AUTH_API_KEY_ID=
CARD_AUTH_SECRET_KEY=

# Cybersource webhook signing key (base64) and its key id. From Cybersource's key service when the
# Pay by Link webhook is registered; until then any local pair works for merchant.simulate_payment.
# Local pair: python -c "import base64,secrets,uuid;print(uuid.uuid4());print(base64.b64encode(secrets.token_bytes(32)).decode())"
CYBS_WEBHOOK_KEY_ID=
CYBS_WEBHOOK_KEY=

# --- relay ledger and wall ---
# Where the relay reaches the merchant server-side (wall panel proxy, /reset); same laptop by default
MERCHANT_URL=http://127.0.0.1:8002

# --- catalog ---
# developer.kroger.com app, scope product.compact. Empty -> synthetic catalog only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=30308
# Only if you registered a Certification app instead of Production
KROGER_API=https://api.kroger.com/v1
