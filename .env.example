# Copy to .env (gitignored). Every service loads the repo-root .env.
# Put the real values in the shared vault, never in git or chat.
# The browser only ever receives an ephemeral voice token, never these keys.
# Keep comments on their own line: some loaders do not strip inline comments.

# --- shared ---
XAI_API_KEY=
# Address the station page and phones use for the services laptop (team router: 192.168.8.10)
SERVICES_HOST=localhost
# Relay ledger ingest; leave empty to keep events local
RELAY_URL=
POLICY_URL=http://127.0.0.1:8001
CATALOG_URL=http://127.0.0.1:8003

# --- station ---
# Origins allowed to call the relay from a browser (mint voice tokens, post events), comma-separated
STATION_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Windows print queue of the station's receipt printer (station/printer.py)
PRINTER_NAME=POS58
# Bearer token the xAI Voice Agent Builder sends to the Chaperone Line's tools (line/server.py, /line/* through
# the tunnel). The line serves nothing without it. python -c "import secrets; print(secrets.token_urlsafe(32))"
LINE_MCP_TOKEN=
# Ruth's four-digit phone PIN: asked before any purchase, bill payment, cancel or return on the line
LINE_PIN=

# --- caregiver passkeys ---
# Public HTTPS host the caregiver phone opens; the passkey RP ID is this host
TUNNEL_HOST=
# Defaults to https://TUNNEL_HOST when empty
ORIGIN=
ROOM_CODE=
# 0 lets a device without user verification register (testing only)
REQUIRE_UV=1
# 1 lets policy run on the default mandate before a passkey signature is stored
MANDATE_UNSIGNED_OK=0
# sha256 hex of the one-time registration code. Empty prints a new code once in the caregiver console.
CAREGIVER_SETUP_CODE_HASH=
# Shared secret between policy and the caregiver app: it keys the six-digit approval codes and the
# approve/reject markers the app sends after checking a passkey. Set the SAME random value on the services
# laptop and the caregiver laptop; the fallback default is public in this repo.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Policy refuses to start without it. POLICY_DEV_KEY_OK=1 allows the public default, for tests on one laptop only.
POLICY_CODE_KEY=
# Priyank's "Call Ruth" link. Digits only, with country code. Empty hides the link.
RUTH_PHONE=

# --- merchant ---
# Cybersource sandbox: Organization ID = merchant id; Key Management -> REST Shared Secret gives key id + secret.
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_API_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=
# 1 = never call Visa (mock hosted page at MERCHANT_PUBLIC_URL/pay/<id>)
MOCK_VISA=0
# 1 = if the Visa call fails, create a mock link instead of failing the order
VISA_FALLBACK_TO_MOCK=1
# Base URL phones/tablets use to reach the merchant. Loopback for a laptop smoke test;
# on the team router set http://192.168.8.10:8002
MERCHANT_PUBLIC_URL=http://127.0.0.1:8002
# off = record the signature check as skipped; enforce = run the RFC 9421 verifier and reject failures
MERCHANT_VERIFY=off
# 1 = orders also get our checkout page (/checkout/<order_id>) that runs a real sandbox card
# authorization and marks paid only on AUTHORIZED (see docs/visa-sandbox-auth-error.md)
CARD_AUTH=0
# Optional: authorize on a different sandbox merchant the team owns (all three or none);
# empty = authorize on the VISA_ACCEPTANCE_* merchant above
CARD_AUTH_MERCHANT_ID=
CARD_AUTH_API_KEY_ID=
CARD_AUTH_SECRET_KEY=

# Cybersource webhook signing key (base64) and its key id. From Cybersource's key service when the
# Pay by Link webhook is registered; until then any local pair works for merchant.simulate_payment.
# Local pair: python -c "import base64,secrets,uuid;print(uuid.uuid4());print(base64.b64encode(secrets.token_bytes(32)).decode())"
CYBS_WEBHOOK_KEY_ID=
CYBS_WEBHOOK_KEY=

# Storefronts on their own Cybersource sandbox accounts (contracts/merchants.json). All three of a prefix, or
# none: a store without its keys makes its links on the VISA_ACCEPTANCE_* account above, tagged with its name.
CYBS_PARKSIDE_MERCHANT_ID=
CYBS_PARKSIDE_API_KEY_ID=
CYBS_PARKSIDE_SECRET_KEY=
CYBS_MAINST_MERCHANT_ID=
CYBS_MAINST_API_KEY_ID=
CYBS_MAINST_SECRET_KEY=
CYBS_PEACHTREE_MERCHANT_ID=
CYBS_PEACHTREE_API_KEY_ID=
CYBS_PEACHTREE_SECRET_KEY=

# Visa Transaction Controls sandbox (merchant/vtc_probe.py): Visa Developer project credentials; the two-way
# SSL cert and key go in keys/visa/ (gitignored). VISA_VTC_PAN is the project's test PAN.
VISA_VDP_USER_ID=
VISA_VDP_PASSWORD=
VISA_VTC_PAN=
# The relay mirrors Ruth's card rules to VTC and asks it about each swipe when the cert and key exist; 0 turns it off.
VTC_MIRROR=
# Per-store Cybersource webhook keys, when a store's account signs its own webhooks: <prefix>WEBHOOK_KEY_ID and
# <prefix>WEBHOOK_KEY, with the prefixes above (CYBS_PARKSIDE_, CYBS_MAINST_, CYBS_PEACHTREE_).

# --- card guard ---
# Lithic sandbox (app.lithic.com -> Settings -> API keys). The Auth Stream Access secret ("whsec_...") comes from
# GET /v1/auth_stream/secret after the responder https://<TUNNEL_HOST>/card/asa is enrolled.
LITHIC_API_KEY=
LITHIC_WEBHOOK_SECRET=

# --- relay ledger and wall ---
# Where the relay reaches the merchant server-side (wall panel proxy, /reset); same laptop by default
MERCHANT_URL=http://127.0.0.1:8002

# --- catalog ---
# developer.kroger.com app, scope product.compact. Empty -> synthetic catalog only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=30308
# Only if you registered a Certification app instead of Production
KROGER_API=https://api.kroger.com/v1

# --- screen and judge ---
# 1 = /judge returns a fixed low score without calling xAI (no key needed)
JUDGE_FAKE=0
# Score at or above which the judge action is refuse_and_alert
JUDGE_THRESHOLD=0.6
# Judge model; grok-4.7 medians about 4 s, over the 3 s timeout
JUDGE_MODEL=grok-4.20-0309-non-reasoning
# Seconds before a judge call raises so policy can fall back
JUDGE_TIMEOUT_S=3
