# Copy to .env. Put the real values in the shared vault, never in git or chat.
# The browser only ever receives an ephemeral voice token, never these keys.

XAI_API_KEY=
MERCHANT_ID=
API_KEY_ID=
SECRET_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
TUNNEL_HOST=
ORIGIN=
ROOM_CODE=

# 1 uses the mock payment link. Set to 0 only when the three Cybersource values above are in the vault.
MOCK_VISA=1

# Laptop smoke uses loopback. On the team router set http://192.168.8.10:8002
MERCHANT_PUBLIC_URL=http://127.0.0.1:8002
CATALOG_URL=http://127.0.0.1:8003
POLICY_URL=http://127.0.0.1:8001
